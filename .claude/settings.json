{
  "permissions": {
    "allow": [
      "Bash(cmd /c *)",
      "Bash(npm *)",
      "Bash(git *)",
      "Bash(node *)"
    ],
    "deny": [
      "Bash(git push *)",
      "Bash(git reset --hard *)",
      "Bash(git clean -f *)",
      "Read(.env*)",
      "Read(**/*.pem)"
    ]
  },
  "enabledMcpjsonServers": [
    "jira"
  ],
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/format-hook.mjs"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node orchestrator/hooks/log-event.mjs",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
