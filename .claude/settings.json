{
  "permissions": {
    "allow": [
      "Bash(cmd /c *)",
      "Bash(npm *)",
      "Bash(git *)",
      "Bash(node *)"
    ]
  },
  "enabledMcpjsonServers": [
    "jira"
  ],
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/format-hook.mjs"
          }
        ]
      }
    ]
  }
}
