{
  "framework-guard": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node hook-runner.mjs guard-bash",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "write_file|edit_file",
        "hooks": [
          {
            "type": "command",
            "command": "node hook-runner.mjs guard-edit",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node hook-runner.mjs guard-bash",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "write_file|edit_file",
        "hooks": [
          {
            "type": "command",
            "command": "node hook-runner.mjs guard-edit",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node hook-runner.mjs guard-bash",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "write_file|edit_file",
        "hooks": [
          {
            "type": "command",
            "command": "node hook-runner.mjs guard-edit",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node hook-runner.mjs log-event",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node hook-runner.mjs log-event",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node hook-runner.mjs log-event",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node hook-runner.mjs guard-handoff",
        "timeout": 30
      },
      {
        "type": "command",
        "command": "node hook-runner.mjs guard-handoff",
        "timeout": 30
      },
      {
        "type": "command",
