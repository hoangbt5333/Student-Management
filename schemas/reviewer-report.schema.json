{
  "$comment": "Báo cáo đánh giá của Reviewer: .task-review.json trong worktree hoặc logs/<exec>/<task>/review.json.",
  "type": "object",
  "required": [
    "task_id",
    "verdict",
    "reviewer",
    "commit",
    "reviewed_at"
  ],
  "additionalProperties": false,
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "verdict": {
      "type": "string",
      "enum": [
        "APPROVED",
        "CHANGES_REQUESTED"
      ]
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,40}$"
    },
    "round": {
      "type": "integer",
      "minimum": 1
    },
    "max_rounds": {
      "type": "integer",
      "minimum": 1
    },
    "reviewed_at": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string"
    },
    "acceptance_criteria_checklist": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "criterion",
          "met"
        ],
        "additionalProperties": false,
        "properties": {
          "criterion": {
            "type": "string",
            "minLength": 1
          },
          "met": {
            "type": "boolean"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "required": [
              "severity",
              "description"
            ],
            "additionalProperties": false,
            "properties": {
              "severity": {
                "type": "string",
                "enum": [
                  "BLOCKER",
                  "MAJOR",
                  "MINOR",
                  "SUGGESTION"
                ]
              },
              "file": {
                "type": "string"
              },
              "line": {
                "type": "integer",
                "minimum": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        ]
      }
    },
    "open_issues": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "needs_human": {
      "type": "boolean"
    }
  }
}
