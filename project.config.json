{
  "framework_version": "0.4.0",
  "project": {
    "name": "user-management",
    "base_branch": "test/multi-agent-framework"
  },
  "commands": {
    "install": {
      "cmd": "pnpm install --frozen-lockfile",
      "timeout_s": 600
    },
    "build": {
      "cmd": "pnpm run build",
      "required": true,
      "timeout_s": 300
    },
    "typecheck": {
      "cmd": "pnpm exec tsc --noEmit -p tsconfig.app.json",
      "required": true,
      "timeout_s": 120
    },
    "lint": {
      "cmd": "pnpm run lint",
      "required": true,
      "timeout_s": 120
    },
    "unit_test": {
      "cmd": "pnpm test -- --watch=false",
      "required": true,
      "timeout_s": 600
    },
    "e2e": {
      "cmd": "pnpm run test:e2e",
      "required": false
    }
  },
  "git": {
    "task_branch_prefix": "task/",
    "integration_branch_prefix": "integration/",
    "worktree_dir": "../wt",
    "merge_strategy": "squash"
  },
  "limits": {
    "max_parallel": 3,
    "max_attempts": 3,
    "max_review_rounds": 2,
    "agent_timeout_min": 30,
    "circuit_breaker_failures": 3
  },
  "ownership": {
    "shared_files": [
      "package.json",
      "pnpm-lock.yaml",
      "src/app/app.routes.ts",
      "src/app/app.config.ts"
    ]
  },
  "security": {
    "deny_read": [
      ".env*",
      "**/*.pem"
    ],
    "require_human_approval": [
      "push",
      "merge_to_base",
      "delete_branch"
    ]
  },
  "models": {
    "architect": "sonnet",
    "coder": "sonnet",
    "reviewer": "sonnet",
    "release": "haiku"
  },
  "handoff": {
    "agent_types": [
      "coder",
      "coding-agent"
    ]
  }
}
