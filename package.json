{
  "name": "user-management",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "concurrently -k \"json-server db.json --port 3001\" \"ng serve\"",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false --reporters=default --reporters=json --output-file=artifacts/test-results.json",
    "check:arch": "node scripts/check-architecture.mjs",
    "validate": "node scripts/quick-validate.mjs",
    "verify": "pnpm run check:arch && pnpm run lint && pnpm run build && pnpm run test:ci",
    "serve:ssr:user-management": "node dist/user-management/server/server.mjs",
    "lint": "ng lint",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report"
  },
  "private": true,
  "packageManager": "pnpm@12.23.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-server": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/ssr": "^22.2.1",
    "@ngrx/signals": "^22.0.1",
    "dotenv": "^18.0.10",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.1",
    "@angular/cli": "^22.2.1",
    "@angular/compiler-cli": "^22.2.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/express": "^5.0.1",
    "@types/node": "^22.12.0",
    "angular-eslint": "22.6.0",
    "concurrently": "^10.0.7",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.0.0",
    "json-server": "^0.17.4",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.71.0",
    "vitest": "^5.0.0"
  }
}
